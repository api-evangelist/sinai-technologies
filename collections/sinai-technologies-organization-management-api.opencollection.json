              {
                "name": "calendar_year",
                "value": "",
                "type": "query",
                "description": "Get reporting months for a specific calendar year"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://auth.sinai.com/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
